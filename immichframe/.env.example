# UID/GID for the immichframe process
# After changing, run: sudo chown -R <PUID>:<PGID> config/ cache/
PUID=1000
PGID=1000

# 8080 is avoided because activepieces uses it
IMMICHFRAME_PORT=8085

# Password of the admin UI (/admin)
# Generate with: openssl rand -hex 24
IMMICHFRAME_ADMIN_PASSWORD=changeme
