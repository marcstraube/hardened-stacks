# UID/GID for the audiobookshelf process
# After changing, run: sudo chown -R <PUID>:<PGID> config/ metadata/ podcasts/
PUID=1000
PGID=1000

AUDIOBOOKSHELF_PORT=13378

# Audiobook library on the host, mounted read-only (e.g. /volume1/media/audiobooks)
AUDIOBOOKSHELF_MEDIA_PATH=./audiobooks
# Podcast folder on the host, writable (episodes are downloaded into it)
AUDIOBOOKSHELF_PODCAST_PATH=./podcasts
