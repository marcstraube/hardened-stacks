# Docker host of the runner VM. ./stacks deploy runs this stack there via SSH.
# The stack is never deployed while this is empty.
REMOTE_DOCKER_HOST=ssh://deploy@runner-vm

# Forgejo URL as reachable from the VM (usually the reverse proxy URL)
FORGEJO_URL=https://git.example.com/

# From Forgejo: Site Administration → Actions → Runners → Create new runner
RUNNER_UUID=
RUNNER_TOKEN=

# Number of jobs running in parallel
RUNNER_CAPACITY=1

# Memory limit for Docker-in-Docker (all job containers share it)
DOCKER_MEM_LIMIT=3g
