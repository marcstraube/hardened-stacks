# UID/GID for immich server and machine-learning containers
# After changing, run: sudo chown -R <PUID>:<PGID> upload/ external/ model-cache/
PUID=1000
PGID=1000
IMMICH_PORT=2283
# Path to photo uploads (e.g. /volume1/photos)
IMMICH_UPLOAD_PATH=./upload
# Path to existing photo library for read-only import (e.g. /volume1/photo)
IMMICH_EXTERNAL_PATH=./external

# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=changeme
