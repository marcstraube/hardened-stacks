# UID/GID for the git user inside the container
# After changing, run: sudo chown -R <PUID>:<PGID> data/
PUID=1000
PGID=1000
FORGEJO_HTTP_PORT=3003
FORGEJO_SSH_PORT=222
# Interface for the SSH port: 127.0.0.1 (local only) or 0.0.0.0 (LAN)
FORGEJO_SSH_BIND=127.0.0.1
FORGEJO_URL=http://localhost:3003
FORGEJO_DOMAIN=localhost
# Create repositories by pushing to a new URL (true/false)
FORGEJO_ENABLE_PUSH_CREATE_USER=false

# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=changeme
