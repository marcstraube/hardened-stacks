FLOPPY_PORT=8010
# Public URL(s) of Floppy, comma-separated (used for CSRF and allowed hosts)
FLOPPY_URLS=http://localhost:8010
# Set to false after creating your account
FLOPPY_REGISTRATION=true
# Language of movie and series metadata from TMDB (e.g. de-DE, fr-FR)
FLOPPY_TMDB_LANG=en

# UID/GID for the floppy process
PUID=1000
PGID=1000

# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=changeme
# Generate with: openssl rand -base64 32
FLOPPY_SECRET=changeme
