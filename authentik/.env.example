# UID/GID for the authentik server and worker containers
# After changing, run: sudo chown -R <PUID>:<PGID> media/ templates/ certs/
PUID=1000
PGID=1000
AUTHENTIK_PORT=9000

# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=changeme
# Generate with: openssl rand -base64 64
AUTHENTIK_SECRET_KEY=changeme
AUTHENTIK_ERROR_REPORTING__ENABLED=false

# First start: open https://<your-domain>/if/flow/initial-setup/
# to create the admin account

