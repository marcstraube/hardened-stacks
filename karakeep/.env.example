# UID/GID for the karakeep and meilisearch processes
# After changing, run: sudo chown -R <PUID>:<PGID> data/ meilisearch/
PUID=1000
PGID=1000

KARAKEEP_PORT=3010
# Public URL of Karakeep (e.g. https://karakeep.example.com)
KARAKEEP_URL=http://localhost:3010
# Set to true after creating your account
KARAKEEP_DISABLE_SIGNUPS=false

# Generate with: openssl rand -base64 36
KARAKEEP_SECRET=changeme
# Generate with: openssl rand -hex 32
MEILI_MASTER_KEY=changeme

# AI tagging via an OpenAI-compatible API; leave the key empty to disable.
# OpenAI: leave KARAKEEP_AI_BASE_URL empty and keep the default models.
# Gemini (key from Google AI Studio):
#   KARAKEEP_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   KARAKEEP_AI_TEXT_MODEL=gemini-3.5-flash-lite
#   KARAKEEP_AI_IMAGE_MODEL=gemini-3.5-flash-lite
# See https://docs.karakeep.app/configuration/different-ai-providers
KARAKEEP_AI_API_KEY=
KARAKEEP_AI_BASE_URL=
KARAKEEP_AI_TEXT_MODEL=gpt-4o-mini
KARAKEEP_AI_IMAGE_MODEL=gpt-4o-mini

# Language of the generated tags (e.g. german)
KARAKEEP_AI_LANG=english
# Tesseract languages for OCR, comma-separated (e.g. eng,deu)
KARAKEEP_OCR_LANGS=eng
