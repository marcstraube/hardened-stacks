# UID/GID for the spoolman process
# After changing, run: sudo chown -R <PUID>:<PGID> data/
PUID=1000
PGID=1000

# Interface for the port: 127.0.0.1 (reverse proxy only) or the LAN IP of
# the host, if a 3D printer (Moonraker) connects to Spoolman directly
SPOOLMAN_BIND=127.0.0.1
SPOOLMAN_PORT=7912

# Public URL of the web UI behind the reverse proxy (e.g. https://spoolman.example.com)
SPOOLMAN_CORS_ORIGIN=
